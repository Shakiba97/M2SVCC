  43           fuel_consumption_ice_2(i,k) 'calculate fuel consumption rate',
  44           fuel_consumption_ev(i,k) 'calculate ev energy consumption rate',
  45           fuel_consumption_ev_2(i,k) 'calculate ev energy consumption rate',
  46           dynamics_speed(i,k) 'dynamics of the speed',
  47           dynamics_position(i,k) 'lower bound of a vehicle position',
  48           car_following(i,k) 'car-following model',
  49           position_penalty(i,k) 'car-following model',
