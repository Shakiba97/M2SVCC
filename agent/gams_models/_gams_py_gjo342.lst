G e n e r a l   A l g e b r a i c   M o d e l i n g   S y s t e m
C o m p i l a t i o n


   1  *option nlp=SCIP;
   2  option nlp=IPOPT;
   3  *option nlp=CONOPT;
   4   
   5  parameter
   6           model_status,
   7           solver_status;
   8  sets
   9           i 'vehicles',
  10           k 'prediction steps';
  11   
  12  parameter
  13           h 'length of the time interval',
  14           tau 'tau in the car-following model',
  15           d_0 'd_0 in the car-following model',
  16           k_dynamics(k) 'dynamic prediction steps used to calculate the differences',
  17           k_critical_points(k) 'the position where there should be critical points',
  18           s_init(i) 'initial position of vehicle i',
  19           s_critical(i,k) 'critical position points of vehicle i at time k',
  20           v_init(i) 'initial speed of vehicle i',
  21           veh_dynamics(i) 'indicator of vehicles to calculate the car-following distances',
  22           veh_ice(i) 'indicator of whether the vehicle is an ice or not';
  23  *$gdxin _gams_py_gdb1
GDXIN   /home/naderian/Desktop/Shakiba/Shakiba97-MMSVCC/MMSVCC/agent/gams_models/_gams_py_gdb684.gdx
--- LOAD  i = 7:i
--- LOAD  k = 1:k
--- LOAD  h = 2:h
--- LOAD  tau = 3:tau
--- LOAD  d_0 = 4:d_0
--- LOAD  k_dynamics = 5:k_dynamics
--- LOAD  k_critical_points = 6:k_critical_points
--- LOAD  s_init = 9:s_init
--- LOAD  s_critical = 8:s_critical
--- LOAD  v_init = 10:v_init
--- LOAD  veh_dynamics = 11:veh_dynamics
--- LOAD  veh_ice = 12:veh_ice
  28   
  29  variable
  30           f 'cost function',
  31           f_inst_ice(i,k) 'the instantanuous fuel consumption rate',
  32           f_inst_ev(i,k) 'the instantanuous energy consumption rate',
  33           f_position(i,k) 'position penalty',
  34           a(i,k) 'acceleration of vehicle i at time step k',
  35           v(i,k) 'speed of vehicle i on lane k at time step k',
  36           s(i,k) 'position of vehicle i on lane k at time step k';
  37   
  38  positive variable a_plus(i,k) 'tp help with power consumption function';
  39   
  40  equations
  41           cost 'cost function',
  42           fuel_consumption_ice(i,k) 'calculate fuel consumption rate',
  43           fuel_consumption_ice_2(i,k) 'calculate fuel consumption rate',
  44           fuel_consumption_ev(i,k) 'calculate ev energy consumption rate',
  45           fuel_consumption_ev_2(i,k) 'calculate ev energy consumption rate',
  46           dynamics_speed(i,k) 'dynamics of the speed',
  47           dynamics_position(i,k) 'lower bound of a vehicle position',
  48           car_following(i,k) 'car-following model',
  49           position_penalty(i,k) 'car-following model',
  50           pos_acceleration 'equation to help with relaxing power consumption equation';
  51   
  52  *Cost function. A relaxed version of Equation (24). We do not require exact match for the critical points. Instead, we try to minimizze the errors for matching those points.
  53  cost..                                                                           f =e= sum(k, sum(i, f_inst_ice(i,k))) + sum(k, sum(i, f_inst_ev(i,k))) + sum(k$(k_critical_points(k) ne 0), sum(i, power(s(i,k) - s_critical(i,k), 2)));
  54  *cost..                                                                           f =e= sum(k$(k_critical_points(k) ne 0), sum(i, power(s(i,k) - s_critical(i,k), 2)));
  55  *cost..                                                                           f =e= sum(k, sum(i, f_inst_ice(i,k))) + sum(k, sum(i, f_inst_ev(i,k)));
  56  *Equation (25a)
  57  dynamics_speed(i,k)$(k_dynamics(k) ne 0)..                                       v(i,k) - v(i,k-1) =e= h*a(i,k-1);
  58   
  59  *Equation (25b)
  60  dynamics_position(i,k)$(k_dynamics(k) ne 0)..                                    s(i,k) - s(i,k-1) =e= h*v(i,k-1) + a(i,k-1)*h*h/2;
  61   
  62  *A relaxed version of Equation (25c)
  63  car_following(i,k)$(veh_dynamics(i) ne 0 and k_dynamics(k) ne 0)..               s(i,k) - s(i+1,k) =g= tau*v(i,k);
  64   
  65  * Help with power consumption equation relaxation
  66  pos_acceleration(i,k)..                                                          a_plus(i,k) =g= a(i,k);
  67   
  68  *Fuel consumption.
  69  fuel_consumption_ev(i,k)$(veh_ice(i) ne 1)..                                     f_inst_ev(i,k) =e= (1266*a_plus(i,k)*v(i,k) + 1266*9.8*0.006*v(i,k) + 1.3*power(v(i,k),3)-0.8 * (log(1 + exp(-10 * a(i,k))) / 10) * v(i,k))/10000;
  70  fuel_consumption_ev_2(i,k)$(veh_ice(i) ne 0)..                                   f_inst_ev(i,k) =e= 0;
  71  fuel_consumption_ice(i,k)$(veh_ice(i) ne 0)..                                    f_inst_ice(i,k) =e= 0.2736 + 0.0599*v(i,k) + 0.3547*a(i,k) - 0.0058*power(v(i,k),2) + 0.0179*v(i,k)*a(i,k) + 0.0663*power(a(i,k),2) + 0.0002*power(v(i,k),3) + 0.002*power(v(i,k),2)*a(i,k) + 0.0245*v(i,k)*power(a(i,k),2) - 0.0489*power(a(i,k),3);
  72  fuel_consumption_ice_2(i,k)$(veh_ice(i) ne 1)..                                  f_inst_ice(i,k) =e= 0;
  73   
  74  *Equation (25e)
  75  a.up(i,k) = 5;
  76  a.lo(i,k) = -5;
  77  v.up(i,k) = 11;
  78  v.lo(i,k) = 0;
  79  s.up(i,k) = 700;
  80  s.lo(i,k) = -200;
  81  v.fx(i,'1') = v_init(i);
  82  s.fx(i,'1') = s_init(i);
  83   
  84  model m /cost, dynamics_speed, dynamics_position, car_following, fuel_consumption_ice, fuel_consumption_ev, fuel_consumption_ice_2, fuel_consumption_ev_2/;
  85   
  86  solve m using nlp minimizing f;
  87  model_status = m.Modelstat;
  88  solver_status = m.solvestat;
