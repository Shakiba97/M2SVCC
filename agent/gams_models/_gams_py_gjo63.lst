C o m p i l a t i o n


   1  *option nlp=SCIP;
   2  option nlp=IPOPT;
   3  *option nlp=CONOPT;
   4   
   5  parameter
   6           model_status,
   7           solver_status;
   8  sets
   9           i 'vehicles',
  10           k 'prediction steps';
  11   
  12  parameter
  13           h 'length of the time interval',
  14           tau 'tau in the car-following model',
  15           d_0 'd_0 in the car-following model',
  16           k_dynamics(k) 'dynamic prediction steps used to calculate the differences',
  17           k_critical_points(k) 'the position where there should be critical points',
  18           s_init(i) 'initial position of vehicle i',
  19           s_critical(i,k) 'critical position points of vehicle i at time k',
  20           v_init(i) 'initial speed of vehicle i',
  21           veh_dynamics(i) 'indicator of vehicles to calculate the car-following distances',
  22           veh_ice(i) 'indicator of whether the vehicle is an ice or not';
  23  *$gdxin _gams_py_gdb1
